# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Authentication & Database:
# Client-side safe configuration. Use publishable/anon key only.
# Never expose the Supabase service_role or secret key in client code.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# ---------------------------------------------------------------------------
# Subscriptions (Razorpay + Supabase)
# ---------------------------------------------------------------------------
# Browser-safe (VITE_ prefix is bundled into the public app; never put secrets here):
VITE_PLAN_PRICE_LABEL="₹50,000 for the first 12 months · ₹4,000 per 12 months after"

# SERVER-ONLY: set these in Netlify (Site configuration > Environment variables).
# Do NOT prefix with VITE_ and do NOT commit real values.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="replace-me"
RAZORPAY_WEBHOOK_SECRET="replace-me"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-me"

# Pricing, in paise (100 paise = INR 1). Must match VITE_PLAN_PRICE_LABEL.
FIRST_YEAR_AMOUNT_PAISE="5000000"   # INR 50,000 for the first 12 months
RENEWAL_AMOUNT_PAISE="400000"       # INR 4,000 for each later 12 months
SUBSCRIPTION_MONTHS="12"
SUBSCRIPTION_CURRENCY="INR"

# 30-day reminder emails (Resend). REMINDER_FROM_EMAIL must be on a domain you verified in Resend.
RESEND_API_KEY="re_replace-me"
REMINDER_FROM_EMAIL="SELL SMART AI <billing@your-domain.com>"
